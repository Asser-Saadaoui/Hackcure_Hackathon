# Copy to .env (never commit it).
APP_DOMAIN=app.example.tn          # patient web app + API (also the API URL of the Android build)
STAFF_DOMAIN=urgences.example.tn   # hospital dashboard
ACME_EMAIL=admin@example.tn        # Let's Encrypt contact
POSTGRES_PASSWORD=change-me-long-random

# LLM interviewer (chat only; decisions are NLP + rules + fusion)
SAHHANITO_LLM_PROVIDER=gemini
GEMINI_API_KEY=
SAHHANITO_GEMINI_MODEL=gemini-3.8-flash

# Hospital simulator speed (simulated minutes per real minute). 1 = real time.
SIM_SPEED=1
# Seconds a hospital has to answer before the case goes to the next one.
REFERRAL_TIMEOUT_EMERGENCY_S=180
REFERRAL_TIMEOUT_HIGH_S=600
# 1 = realistic simulated ambulance; higher = faster (demos).
AMBULANCE_TIME_SCALE=1
