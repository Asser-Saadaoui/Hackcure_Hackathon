{
  "expo": {
    "name": "Sahhanito",
    "slug": "sahhanito",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/sahhanito-icon.png",
    "scheme": "sahhanito",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/images/sahhanito-icon.png",
      "bundleIdentifier": "tn.sahhanito.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F1FAF5",
        "foregroundImage": "./assets/images/hassanito.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "tn.sahhanito.app",
      "versionCode": 1,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/sahhanito-icon.png",
      "name": "Sahhanito",
      "shortName": "Sahhanito",
      "themeColor": "#177082",
      "backgroundColor": "#F1FAF5"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F1FAF5",
          "image": "./assets/images/hassanito.png",
          "imageWidth": 112
        }
      ],
      "expo-localization",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Sahhanito uses your location to find the nearest hospital that can treat you."
        }
      ],
      "expo-asset",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
