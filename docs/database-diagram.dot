  "Referral" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white" COLOR="#C62828"><TR><TD BGCOLOR="#C62828" ALIGN="CENTER"><FONT COLOR="white"><B>Referral</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#888888" POINT-SIZE="9">PK </FONT><B>id</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#888888" POINT-SIZE="9">FK </FONT>caseId</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#888888" POINT-SIZE="9">FK </FONT>facilityId</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#888888" POINT-SIZE="9">FK </FONT>departmentId?</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#888888" POINT-SIZE="9">FK </FONT>previousReferralId? (UK)</TD></TR><TR><TD ALIGN="LEFT">status</TD></TR><TR><TD ALIGN="LEFT">treatmentStatus</TD></TR><TR><TD ALIGN="LEFT">origin</TD></TR><TR><TD ALIGN="LEFT">scoreBreakdown</TD></TR><TR><TD ALIGN="LEFT">distanceKm, etaAt</TD></TR><TR><TD ALIGN="LEFT">decisionDueAt</TD></TR><TR><TD ALIGN="LEFT">decidedById / At / Reason</TD></TR><TR><TD ALIGN="LEFT">acceptNote</TD></TR><TR><TD ALIGN="LEFT">arrivalMode (SELF/AMBULANCE)</TD></TR><TR><TD ALIGN="LEFT">trackingShared, lastPositionAt</TD></TR><TR><TD ALIGN="LEFT">arrivedAt, completedAt</TD></TR></TABLE>>];
  "InfoRequest" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white" COLOR="#C62828"><TR><TD BGCOLOR="#C62828" ALIGN="CENTER"><FONT COLOR="white"><B>InfoRequest</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#888888" POINT-SIZE="9">PK </FONT><B>id</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#888888" POINT-SIZE="9">FK </FONT>referralId</TD></TR><TR><TD ALIGN="LEFT">question (+localized)</TD></TR><TR><TD ALIGN="LEFT">answerType, options[]</TD></TR><TR><TD ALIGN="LEFT">askedById / At</TD></TR><TR><TD ALIGN="LEFT">answer, answeredVia / At</TD></TR></TABLE>>];
  "ChatMessage" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white" COLOR="#C62828"><TR><TD BGCOLOR="#C62828" ALIGN="CENTER"><FONT COLOR="white"><B>ChatMessage</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#888888" POINT-SIZE="9">PK </FONT><B>id</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#888888" POINT-SIZE="9">FK </FONT>referralId</TD></TR><TR><TD ALIGN="LEFT">sender (PATIENT/STAFF/SYSTEM)</TD></TR><TR><TD ALIGN="LEFT">senderId</TD></TR><TR><TD ALIGN="LEFT">kind</TD></TR><TR><TD ALIGN="LEFT">text, translation</TD></TR><TR><TD ALIGN="LEFT">infoRequestId?</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#888888" POINT-SIZE="9">UK </FONT>clientRequestId</TD></TR><TR><TD ALIGN="LEFT">readAt</TD></TR></TABLE>>];
  "TrackingPoint" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white" COLOR="#C62828"><TR><TD BGCOLOR="#C62828" ALIGN="CENTER"><FONT COLOR="white"><B>TrackingPoint</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#888888" POINT-SIZE="9">PK </FONT><B>id</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#888888" POINT-SIZE="9">FK </FONT>referralId</TD></TR><TR><TD ALIGN="LEFT">source (PATIENT/AMBULANCE_SIM)</TD></TR><TR><TD ALIGN="LEFT">lat, lng, accuracyM</TD></TR><TR><TD ALIGN="LEFT">speedKmh</TD></TR><TR><TD ALIGN="LEFT">recordedAt</TD></TR></TABLE>>];
  "AmbulanceDispatch" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white" COLOR="#C62828"><TR><TD BGCOLOR="#C62828" ALIGN="CENTER"><FONT COLOR="white"><B>AmbulanceDispatch</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#888888" POINT-SIZE="9">PK </FONT><B>id</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#888888" POINT-SIZE="9">FK </FONT>referralId (UK)</TD></TR><TR><TD ALIGN="LEFT">unitName</TD></TR><TR><TD ALIGN="LEFT">simulated</TD></TR><TR><TD ALIGN="LEFT">status</TD></TR><TR><TD ALIGN="LEFT">route (polyline)</TD></TR><TR><TD ALIGN="LEFT">currentLat / Lng</TD></TR><TR><TD ALIGN="LEFT">etaAt</TD></TR></TABLE>>];
