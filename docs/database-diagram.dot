digraph Sahhanito {
graph [rankdir=LR, splines=true, overlap=false, nodesep=0.35, ranksep=1.1, fontname="Helvetica", fontsize=22, labelloc=t, pad=0.4,
       label=<<B>Sahhanito (HackCure) — database draft</B><BR/><FONT POINT-SIZE="13">PostgreSQL / Prisma · 32 tables · source of truth: docs/hackcure-app.md §14 · 2026-10-09</FONT>>];
node [shape=plain, fontname="Helvetica", fontsize=11];
edge [color="#607D8B", arrowhead=crow, arrowtail=tee, dir=both, fontname="Helvetica", fontsize=9, fontcolor="#455A64"];
subgraph cluster_0 { label=<<B>1 · Hospital directory (Grand Tunis)</B>>; fontsize=15; style="rounded,filled"; fillcolor="#E3F2FD"; color="#1565C0"; fontcolor="#1565C0";
  "Facility" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white" COLOR="#1565C0"><TR><TD BGCOLOR="#1565C0" ALIGN="CENTER"><FONT COLOR="white"><B>Facility</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#888888" POINT-SIZE="9">PK </FONT><B>id</B></TD></TR><TR><TD ALIGN="LEFT">name</TD></TR><TR><TD ALIGN="LEFT">type</TD></TR><TR><TD ALIGN="LEFT">governorate</TD></TR><TR><TD ALIGN="LEFT">lat, lng</TD></TR><TR><TD ALIGN="LEFT">hasGeneralEd</TD></TR><TR><TD ALIGN="LEFT">edPhone</TD></TR><TR><TD ALIGN="LEFT">isActive</TD></TR><TR><TD ALIGN="LEFT">decisionTimeoutEmergencySec</TD></TR><TR><TD ALIGN="LEFT">decisionTimeoutHighSec</TD></TR><TR><TD ALIGN="LEFT">alertDelaySec</TD></TR><TR><TD ALIGN="LEFT">availabilityStaleAfterMin</TD></TR><TR><TD ALIGN="LEFT">availabilityConfirmedAt</TD></TR><TR><TD ALIGN="LEFT">apiKeyHash</TD></TR></TABLE>>];
  "Specialty" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white" COLOR="#1565C0"><TR><TD BGCOLOR="#1565C0" ALIGN="CENTER"><FONT COLOR="white"><B>Specialty</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#888888" POINT-SIZE="9">PK </FONT><B>code</B></TD></TR><TR><TD ALIGN="LEFT">nameFr / nameAr / nameEn</TD></TR></TABLE>>];
  "Department" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white" COLOR="#1565C0"><TR><TD BGCOLOR="#1565C0" ALIGN="CENTER"><FONT COLOR="white"><B>Department</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#888888" POINT-SIZE="9">PK </FONT><B>id</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#888888" POINT-SIZE="9">FK </FONT>facilityId</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#888888" POINT-SIZE="9">FK </FONT>specialtyCode</TD></TR><TR><TD ALIGN="LEFT">hasEmergency</TD></TR><TR><TD ALIGN="LEFT">status (manual)</TD></TR><TR><TD ALIGN="LEFT">bedsAvailable (manual)</TD></TR><TR><TD ALIGN="LEFT">specialistsOnDuty (manual)</TD></TR><TR><TD ALIGN="LEFT">estimatedWaitMin (manual)</TD></TR><TR><TD ALIGN="LEFT">statusUpdatedAt / ById</TD></TR></TABLE>>];
  "CapacitySnapshot" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white" COLOR="#1565C0"><TR><TD BGCOLOR="#1565C0" ALIGN="CENTER"><FONT COLOR="white"><B>CapacitySnapshot</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#888888" POINT-SIZE="9">PK </FONT><B>id</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#888888" POINT-SIZE="9">FK </FONT>departmentId</TD></TR><TR><TD ALIGN="LEFT">status</TD></TR><TR><TD ALIGN="LEFT">bedsAvailable</TD></TR><TR><TD ALIGN="LEFT">specialistsOnDuty</TD></TR><TR><TD ALIGN="LEFT">estimatedWaitMin</TD></TR><TR><TD ALIGN="LEFT">updatedById</TD></TR><TR><TD ALIGN="LEFT">confirmOnly</TD></TR><TR><TD ALIGN="LEFT">takenAt</TD></TR></TABLE>>];
  "Equipment" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white" COLOR="#1565C0"><TR><TD BGCOLOR="#1565C0" ALIGN="CENTER"><FONT COLOR="white"><B>Equipment</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#888888" POINT-SIZE="9">PK </FONT><B>code</B></TD></TR><TR><TD ALIGN="LEFT">nameFr / nameAr / nameEn</TD></TR></TABLE>>];
  "FacilityEquipment" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white" COLOR="#1565C0"><TR><TD BGCOLOR="#1565C0" ALIGN="CENTER"><FONT COLOR="white"><B>FacilityEquipment</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#888888" POINT-SIZE="9">PK,FK </FONT><B>facilityId</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#888888" POINT-SIZE="9">PK,FK </FONT><B>equipmentCode</B></TD></TR><TR><TD ALIGN="LEFT">operational (scanner up/down)</TD></TR><TR><TD ALIGN="LEFT">updatedAt / ById</TD></TR></TABLE>>];
  "OnCallShift" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white" COLOR="#1565C0"><TR><TD BGCOLOR="#1565C0" ALIGN="CENTER"><FONT COLOR="white"><B>OnCallShift</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#888888" POINT-SIZE="9">PK </FONT><B>id</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#888888" POINT-SIZE="9">FK </FONT>facilityId</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#888888" POINT-SIZE="9">FK </FONT>specialtyCode</TD></TR><TR><TD ALIGN="LEFT">startsAt</TD></TR><TR><TD ALIGN="LEFT">endsAt</TD></TR></TABLE>>];
  "FacilityUnavailability" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white" COLOR="#1565C0"><TR><TD BGCOLOR="#1565C0" ALIGN="CENTER"><FONT COLOR="white"><B>FacilityUnavailability</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#888888" POINT-SIZE="9">PK </FONT><B>id</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#888888" POINT-SIZE="9">FK </FONT>facilityId</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#888888" POINT-SIZE="9">FK </FONT>specialtyCode?</TD></TR><TR><TD ALIGN="LEFT">reason</TD></TR><TR><TD ALIGN="LEFT">until</TD></TR><TR><TD ALIGN="LEFT">createdById</TD></TR></TABLE>>];
  "DeliveryChannel" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white" COLOR="#1565C0"><TR><TD BGCOLOR="#1565C0" ALIGN="CENTER"><FONT COLOR="white"><B>DeliveryChannel</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#888888" POINT-SIZE="9">PK </FONT><B>id</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#888888" POINT-SIZE="9">FK </FONT>facilityId</TD></TR><TR><TD ALIGN="LEFT">type (WEBHOOK_FHIR)</TD></TR><TR><TD ALIGN="LEFT">target</TD></TR><TR><TD ALIGN="LEFT">secret</TD></TR><TR><TD ALIGN="LEFT">active</TD></TR></TABLE>>];
}
subgraph cluster_1 { label=<<B>2 · People &amp; access</B>>; fontsize=15; style="rounded,filled"; fillcolor="#F3E5F5"; color="#6A1B9A"; fontcolor="#6A1B9A";
  "User" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white" COLOR="#6A1B9A"><TR><TD BGCOLOR="#6A1B9A" ALIGN="CENTER"><FONT COLOR="white"><B>User</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#888888" POINT-SIZE="9">PK </FONT><B>id</B></TD></TR><TR><TD ALIGN="LEFT">role (PATIENT/STAFF/ADMIN)</TD></TR><TR><TD ALIGN="LEFT">isAnonymous</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#888888" POINT-SIZE="9">UK </FONT>deviceId</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#888888" POINT-SIZE="9">UK </FONT>phone?</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#888888" POINT-SIZE="9">UK </FONT>email (staff)</TD></TR><TR><TD ALIGN="LEFT">passwordHash</TD></TR><TR><TD ALIGN="LEFT">name</TD></TR><TR><TD ALIGN="LEFT">language</TD></TR><TR><TD ALIGN="LEFT">birthYear, sex, pregnant</TD></TR><TR><TD ALIGN="LEFT">consentVersion / At</TD></TR><TR><TD ALIGN="LEFT">active</TD></TR><TR><TD ALIGN="LEFT">mustChangePassword</TD></TR></TABLE>>];
  "StaffMembership" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white" COLOR="#6A1B9A"><TR><TD BGCOLOR="#6A1B9A" ALIGN="CENTER"><FONT COLOR="white"><B>StaffMembership</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#888888" POINT-SIZE="9">PK </FONT><B>id</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#888888" POINT-SIZE="9">FK </FONT>userId</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#888888" POINT-SIZE="9">FK </FONT>facilityId</TD></TR><TR><TD ALIGN="LEFT">facilityRole (ED/CLINICIAN/MANAGER)</TD></TR><TR><TD ALIGN="LEFT">supervisesNetwork</TD></TR><TR><TD ALIGN="LEFT">active</TD></TR></TABLE>>];
}
subgraph cluster_2 { label=<<B>3 · Triage &amp; AI</B>>; fontsize=15; style="rounded,filled"; fillcolor="#E8F5E9"; color="#2E7D32"; fontcolor="#2E7D32";
  "Case" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white" COLOR="#2E7D32"><TR><TD BGCOLOR="#2E7D32" ALIGN="CENTER"><FONT COLOR="white"><B>Case</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#888888" POINT-SIZE="9">PK </FONT><B>id</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#888888" POINT-SIZE="9">UK </FONT>referenceCode (HC-…)</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#888888" POINT-SIZE="9">FK </FONT>patientId</TD></TR><TR><TD ALIGN="LEFT">status</TD></TR><TR><TD ALIGN="LEFT">currentLevel</TD></TR><TR><TD ALIGN="LEFT">currentAssessmentId</TD></TR><TR><TD ALIGN="LEFT">reviewStatus</TD></TR><TR><TD ALIGN="LEFT">reviewDueAt</TD></TR><TR><TD ALIGN="LEFT">degraded</TD></TR><TR><TD ALIGN="LEFT">lat, lng, accuracy</TD></TR><TR><TD ALIGN="LEFT">locationSource / Address</TD></TR><TR><TD ALIGN="LEFT">locationConfirmedAt</TD></TR><TR><TD ALIGN="LEFT">patientTokenHash</TD></TR><TR><TD ALIGN="LEFT">lastPatientContactAt</TD></TR><TR><TD ALIGN="LEFT">createdAt / closedAt</TD></TR></TABLE>>];
  "Turn" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white" COLOR="#2E7D32"><TR><TD BGCOLOR="#2E7D32" ALIGN="CENTER"><FONT COLOR="white"><B>Turn</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#888888" POINT-SIZE="9">PK </FONT><B>id</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#888888" POINT-SIZE="9">FK </FONT>caseId</TD></TR><TR><TD ALIGN="LEFT">index</TD></TR><TR><TD ALIGN="LEFT">role</TD></TR><TR><TD ALIGN="LEFT">text</TD></TR><TR><TD ALIGN="LEFT">normalizedText</TD></TR><TR><TD ALIGN="LEFT">language / script</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#888888" POINT-SIZE="9">UK </FONT>clientRequestId</TD></TR><TR><TD ALIGN="LEFT">aiLatencyMs</TD></TR></TABLE>>];
  "CaseState" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white" COLOR="#2E7D32"><TR><TD BGCOLOR="#2E7D32" ALIGN="CENTER"><FONT COLOR="white"><B>CaseState</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#888888" POINT-SIZE="9">PK </FONT><B>id</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#888888" POINT-SIZE="9">FK </FONT>caseId</TD></TR><TR><TD ALIGN="LEFT">version</TD></TR><TR><TD ALIGN="LEFT">data (CaseState JSON)</TD></TR><TR><TD ALIGN="LEFT">missingInfo</TD></TR><TR><TD ALIGN="LEFT">source (AI/CLINICIAN)</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#888888" POINT-SIZE="9">FK </FONT>turnId?</TD></TR><TR><TD ALIGN="LEFT">createdById</TD></TR></TABLE>>];
  "RiskAssessment" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white" COLOR="#2E7D32"><TR><TD BGCOLOR="#2E7D32" ALIGN="CENTER"><FONT COLOR="white"><B>RiskAssessment</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#888888" POINT-SIZE="9">PK </FONT><B>id</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#888888" POINT-SIZE="9">FK </FONT>caseId</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#888888" POINT-SIZE="9">FK </FONT>stateId</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#888888" POINT-SIZE="9">FK </FONT>turnId?</TD></TR><TR><TD ALIGN="LEFT">pNlp, nlpConfidence</TD></TR><TR><TD ALIGN="LEFT">sRule, triggeredRules</TD></TR><TR><TD ALIGN="LEFT">pFinal</TD></TR><TR><TD ALIGN="LEFT">level</TD></TR><TR><TD ALIGN="LEFT">uncertainty</TD></TR><TR><TD ALIGN="LEFT">contributions</TD></TR><TR><TD ALIGN="LEFT">actions</TD></TR><TR><TD ALIGN="LEFT">suggestedSpecialty</TD></TR><TR><TD ALIGN="LEFT">requiredEquipment[]</TD></TR><TR><TD ALIGN="LEFT">rationale</TD></TR><TR><TD ALIGN="LEFT">versions</TD></TR></TABLE>>];
}
subgraph cluster_3 { label=<<B>4 · Clinician supervision</B>>; fontsize=15; style="rounded,filled"; fillcolor="#FFF3E0"; color="#E65100"; fontcolor="#E65100";
  "Review" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white" COLOR="#E65100"><TR><TD BGCOLOR="#E65100" ALIGN="CENTER"><FONT COLOR="white"><B>Review</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#888888" POINT-SIZE="9">PK </FONT><B>id</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#888888" POINT-SIZE="9">FK </FONT>caseId</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#888888" POINT-SIZE="9">FK </FONT>assessmentId</TD></TR><TR><TD ALIGN="LEFT">gate (1–4)</TD></TR><TR><TD ALIGN="LEFT">decision</TD></TR><TR><TD ALIGN="LEFT">reviewerId</TD></TR><TR><TD ALIGN="LEFT">note</TD></TR></TABLE>>];
