  "Escalation" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white" COLOR="#E65100"><TR><TD BGCOLOR="#E65100" ALIGN="CENTER"><FONT COLOR="white"><B>Escalation</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#888888" POINT-SIZE="9">PK </FONT><B>id</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#888888" POINT-SIZE="9">FK </FONT>caseId</TD></TR><TR><TD ALIGN="LEFT">referralId</TD></TR><TR><TD ALIGN="LEFT">fromLevel → toLevel</TD></TR><TR><TD ALIGN="LEFT">reason</TD></TR><TR><TD ALIGN="LEFT">instruction</TD></TR><TR><TD ALIGN="LEFT">byId (null = auto)</TD></TR><TR><TD ALIGN="LEFT">automatic</TD></TR></TABLE>>];
}
