# Copy to ai/.env (git-ignored). Same Gemini key as the central-park fork.
SAHHANITO_LLM_PROVIDER=gemini
GEMINI_API_KEY=
SAHHANITO_GEMINI_MODEL=gemini-3.8-flash
# SAHHANITO_LLM=off            # force the templates
# SAHHANITO_CORS=http://localhost:8081
# Tried in order when the main model is out of quota (comma-separated):
# SAHHANITO_GEMINI_FALLBACKS=gemini-3.7-flash,gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-2.5-flash-lite
