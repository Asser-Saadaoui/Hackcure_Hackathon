      "\\b(?:7|8|9|10)\\s*sur\\s*10\\b|tres\\s+tres\\s+mal|douleur\\s+(?:tres\\s+)?(?:forte|intense)",
      "y?o?[jg][ae3]+(?:ni)?\\s*barcha\\s*barcha|wji3a\\s*9wiya\\s*barcha",
