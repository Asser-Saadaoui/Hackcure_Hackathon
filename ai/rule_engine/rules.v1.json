  },
  "rules": [
    {
      "id": "R-CARD-01",
      "name": "Chest pain with breathing difficulty",
      "severity": "critical",
      "when": {
        "any": [
          {
            "screen": "chest_dyspnea"
          },
          {
            "all": [
              {
                "any": [
                  {
                    "fact": {
                      "kind": "symptom",
                      "name": [
                        "chest"
                      ]
                    }
                  },
                  {
                    "text": "chest_pain"
                  }
                ]
              },
              {
                "any": [
                  {
                    "fact": {
                      "kind": "symptom",
                      "name": [
                        "breath",
                        "breath_severe",
                        "cannot_breathe"
                      ]
                    }
                  },
                  {
                    "text": "cannot_breathe"
                  }
                ]
              }
            ]
          }
        ]
      },
      "specialty": "CARDIO",
      "equipment": [
        "CATH_LAB"
      ],
      "rationale": {
        "fr": "Douleur thoracique avec difficulté à respirer.",
        "en": "Chest pain with breathing difficulty.",
        "ar": "ألم في الصدر مع صعوبة في التنفس.",
        "darija": "وجيعة في الصدر مع صعوبة في التنفس."
      }
    },
    {
      "id": "R-RESP-01",
