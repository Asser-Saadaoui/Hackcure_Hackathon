{
  "version": "sahhanito-rules-2",
  "validation_status": "unvalidated_prototype: wording, thresholds and weights must be reviewed by a clinician before any real use",
  "severity_policy": {
    "critical": {
      "level_floor": "EMERGENCY",
      "score": 1.0
    },
    "high": {
      "level_floor": "HIGH"
    },
    "moderate": {
      "level_floor": null
    }
  },
  "negation_cues": [
    "\\b(?:no|not|without|never|denies|denied|don.?t|doesn.?t|didn.?t|isn.?t)\\b",
    "\\b(?:pas|sans|aucune?|jamais|ni)\\b",
    "\\b(?:ma\\s*\\S+ch|mouch|moch|mich|mch|mafamm?ech|ma\\s*fammech|bla|blech)\\b",
    "(?:^|\\s)(?:ما\\s*\\S+ش|ماعنديش|معنديش|موش|مش|لا|بلا|بلاش)(?=\\s|$)"
  ],
  "context_cues": [
    "\\b(?:if|what if|last year|years ago|in the past|used to|afraid of|worried about)\\b",
    "\\b(?:si|l.?annee derniere|il y a (?:des|plusieurs) ans|autrefois|peur de|j.?ai peur)\\b",
    "\\b(?:ken|kenou|3am elli fet|3am lfet|zman|5ayef|nkhaf|n5af)\\b",
    "(?:^|\\s)(?:اذا|العام\\s*الفات|زمان|خايف|نخاف)(?=\\s|$)"
  ],
  "clause_breaks": "[.;!?\\n,]|\\b(?:but|however|mais|cependant|ama|amma|ema)\\b|(?:^|\\s)(?:لكن|اما|أما)(?=\\s|$)",
  "lexicon": {
    "cannot_breathe": [
      "can.?t breathe|cannot breathe|unable to breathe|struggling to breathe|choking",
      "je n.?arrive (?:pas|plus) a respirer|j.?etouffe|il etouffe|elle etouffe|etouffement",
      "ma\\s*n[ae]?j[ae]?m(?:e)?ch\\s*n[ae]?tn[ae]f+[ae]s|n7[ae]s+\\s*rou7i\\s*m[kh5]+nou9|m[kh5]nou9|m5an9a|nefsi\\s*ma9tou3",
      "ما\\s*نجمش\\s*نتنفس|مخنوق|مخنوقة|نختنق|نفسي\\s*مقطوع"
    ],
    "chest_pain": [
      "chest (?:pain|pressure|tightness)|pain in (?:my|his|her) chest",
      "douleur (?:thoracique|a la poitrine|dans la poitrine)|mal (?:a|dans) la poitrine|serrement (?:a|dans) la poitrine",
      "sadr(?:i|ou|ha)\\s*y?o?[jg][ae3]+(?:ni|ou|ha)|w[jg]a3\\s*(?:fi|f|fel)\\s*sadr(?:i|ou|ha)|wji3a\\s*(?:fi|f)\\s*sadr",
      "وجع\\s*في\\s*(?:صدري|الصدر)|صدري\\s*يوجعني|وجيعة\\s*في\\s*صدري"
    ],
    "unconscious": [
      "unconscious|unresponsive|passed out|not waking up|won.?t wake up",
      "inconscient|perdu connaissance|ne se reveille pas|ne repond (?:pas|plus)|evanoui",
      "m?ghchi\\s*3lih|m?ghchi\\s*3liha|ghchaw?\\s*3lih|fa9ed\\s*el\\s*wa3[iy]|ma\\s*y?fi9ch|ma\\s*t?fi9ch",
      "مغشي\\s*عليه|مغشي\\s*عليها|فاقد\\s*الوعي|ما\\s*يفيقش|ما\\s*تفيقش"
    ],
    "seizure": [
      "seizure|convulsing|convulsions?|fitting",
      "convuls\\w*|crise d.?epilepsie|crise epileptique",
      "y?t?chan[jg]a|tchanj|kriz[ae]\\s*(?:sar3|epilep)",
      "يتشنج|تتشنج|تشنج|نوبة\\s*صرع"
    ],
    "stroke_signs": [
      "face (?:is )?droop\\w*|one side of (?:my|his|her) (?:body|face)|can.?t move (?:my|his|her) (?:arm|leg)|slurred speech",
      "visage (?:paralyse|tordu)|bouche (?:tordue|de travers)|bras (?:paralyse|qui ne bouge plus)|paralysie|parole pateuse|ne peut plus parler",
      "wejh(?:i|ou|a|ha)\\s*mayel|fomm(?:i|ou|a|ha)\\s*mayel|ma\\s*(?:y|t|n)?(?:n[ae]j[ae]?m(?:e)?ch|9d[ae]rch)\\s*(?:y|t|n)?(?:[ae]?7ki|ahki|hki)|nos+\\s*bdan(?:i|ou|ha)|ma\\s*y?n[ae]jemch\\s*y?7ar+ek|kl[ae]m(?:ou|ha)\\s*met5alet",
      "وجه[هوي]?\\s*مايل|فم[هوي]?\\s*مايل|نص\\s*بدن|شلل|كلامو\\s*متخلط"
    ],
    "heavy_bleeding": [
      "bleeding (?:heavily|a lot|won.?t stop|that won.?t stop)|heavy bleeding|hemorrhag\\w*|losing a lot of blood",
      "saign\\w* (?:abondant\\w*|beaucoup|sans arret)|hemorragie|perd beaucoup de sang",
      "dam\\s*barcha|dam\\s*ma\\s*7abech\\s*yo9of|nzif\\s*9wi",
      "دم\\s*برشة|نزيف\\s*قوي|الدم\\s*ما\\s*حبش\\s*يوقف"
    ],
    "blood_loss_gi": [
      "vomiting blood|vomited blood|coughing (?:up )?blood|black (?:tarry )?stools?",
      "vomi\\w* (?:du )?sang|crache\\w* du sang|selles noires",
      "y?[tn]9ay+a\\s*dam|y?raj+a3\\s*dam|y?ko7\\s*dam",
      "يتقيا\\s*دم|يرجع\\s*دم|يكح\\s*دم|نرجع\\s*دم"
    ],
    "anaphylaxis": [
      "throat (?:is )?(?:swelling|swollen|closing)|tongue (?:is )?swell\\w*|lips? (?:are )?swell\\w*|anaphyla\\w*",
      "gorge (?:gonflee|qui gonfle|serree)|levres gonflees|langue gonflee|choc anaphylactique|oedeme de quincke",
      "7al9(?:i|ou|ha)\\s*manfou5|lsan(?:i|ou|ha)\\s*manfou5|fomm(?:i|ou|ha)\\s*manfou5",
      "حلق[هيو]?\\s*منفوخ|لسان[هيو]?\\s*منفوخ|فم[هيو]?\\s*منفوخ"
    ],
    "suicidal": [
      "kill myself|suicid\\w*|want to die|end my life|take my own life",
      "envie de mourir|(?:veux|vais) (?:mourir|me tuer|me suicider)|en finir avec (?:la|ma) vie",
      "n7[ae]b+\\s*nmout|b[ae]ch\\s*n[9q]t[ae]l\\s*rou7i|n[9q]at[ae]l\\s*rou7i|nentar\\w*",
      "نحب\\s*نموت|باش\\s*نقتل\\s*روحي|ننتحر|انتحار"
    ],
    "poisoning": [
      "poison\\w*|overdos\\w*|swallowed (?:pills|bleach|medicine)|carbon monoxide|took too many pills",
      "intoxi\\w*|empoisonn\\w*|surdose|avale (?:des|trop de) (?:medicaments|comprimes)|eau de javel|monoxyde",
      "chr[ae]b\\s*(?:jafel|javel|jefel)|k?la\\s*dwe?a?\\s*barcha|ts[ae]m+[ae]m|ms[ae]m+[ae]m",
      "شرب\\s*جافال|تسمم|مسموم|بلع\\s*دواء\\s*برشة|حبوب\\s*برشة"
    ],
    "major_trauma": [
      "car accident|hit by a (?:car|truck|bus)|fell from (?:a height|the roof|the stairs|a ladder)|stab(?:bed|bing)?|gunshot|got shot|been shot",
      "accident (?:de (?:la )?(?:route|voiture|moto|circulation))|renverse par|chute (?:de|d.?un) (?:haut|etage|toit|echelle|escalier)|coup de couteau|poignarde",
      "acci?dent(?!\\s*vasculaire)|kar7ba\\s*dh?rbet(?:ou|ha)|tay7\\s*m(?:en|el)\\s*(?:fo9|sta7|etage|sellom)|dh?rbou\\s*b\\s*(?:mous|sekkina)",
      "حادث|كرهبة\\s*ضربت|طاح\\s*من\\s*(?:الفوق|السطح)|ضربو\\s*بموس|بسكينة"
    ],
    "head_injury": [
      "hit (?:my|his|her) head|head injury|banged (?:my|his|her) head",
      "(?:coup|choc|traumatisme) (?:a|sur) la tete|traumatisme cranien",
      "dh?rab\\s*ras(?:ou|i|ha)|tay7\\s*3la\\s*ras(?:ou|i|ha)",
      "ضرب\\s*راس|طاح\\s*على\\s*راس"
    ],
    "severe_burn": [
      "severe burn|badly burn\\w*|burns? (?:on|all over) (?:my|his|her) (?:face|body)",
      "brulure (?:grave|etendue|au visage)|grand brule|brule (?:gravement|partout|au visage)",
      "t7ra9|ma7rou9|ma7rou9a|7ar9a\\s*kbira",
      "تحرق|محروق|محروقة|حرقة\\s*كبيرة"
    ],
    "pregnancy": [
      "pregnant|pregnancy",
      "enceinte|grossesse",
      "7am[ae]l|7amla",
      "حامل|حاملة"
    ],
    "pregnancy_bleeding": [
      "vaginal bleeding|bleeding from (?:the )?vagina",
      "saignement\\w* vaginal\\w*|pertes de sang|saigne",
      "dam\\s*m(?:en|el)\\s*ta7t|nzif",
      "دم\\s*من\\s*التحت|نزيف"
    ],
    "labour": [
      "water broke|waters broke|in labou?r|contractions",
      "perte des eaux|contractions|accouch\\w*",
      "el\\s*ma\\s*habet|b[ae]ch\\s*tool?ed|tal9",
      "نزل\\s*الماء|باش\\s*تولد|الطلق"
    ],
    "vision_loss": [
      "can.?t see|cannot see|lost (?:my )?vision|sudden(?:ly)? blind\\w*",
      "ne vois? (?:plus|rien)|perte (?:brutale )?de (?:la )?vue",
      "ma\\s*nchoufch|ma\\s*walit(?:ch)?\\s*nchouf",
      "ما\\s*نشوفش|ما\\s*وليتش\\s*نشوف"
    ],
    "worst_headache": [
      "worst headache|thunderclap|sudden severe headache",
      "pire mal de tete|mal de tete (?:brutal|violent|soudain)|coup de tonnerre",
      "a9wa\\s*wja3\\s*ras|wja3\\s*ras\\s*faj2a",
      "اقوى\\s*وجع\\s*راس|وجع\\s*راس\\s*فجاة"
    ],
    "infant": [
      "\\bbaby\\b|newborn|infant",
      "bebe|nourrisson|nouveau.ne",
      "bebe|rdhi3|sghir\\s*3omr(?:ou|ha)\\s*\\d+\\s*(?:ch[h7]ar|chhour|nhar|jour)",
