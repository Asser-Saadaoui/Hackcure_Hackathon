    "fracture": [
      "\\bbroke(?:n)?\\s+(?:my|his|her|a)?\\s*(?:leg|arm|wrist|ankle|hip|bone|knee|shoulder|foot|hand|rib)|fractur\\w*",
      "fractur\\w*|(?:je\\s+me\\s+suis|il\\s+s.est|elle\\s+s.est)\\s+cass\\w*|(?:jambe|bras|poignet|cheville|hanche|genou|epaule|pied|main)\\s+cass\\w*",
      "t?k[ae]ss?[ae]r(?:et|it|ou)?\\b|m(?:e)?k[ae]ss?(?:ou)?r[ae]?\\b|(?:sa9|ydi|yedi|rjel|kraa?)\\w*\\s*t?k[ae]ss?r",
