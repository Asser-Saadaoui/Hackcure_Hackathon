    ],
    "unbearable_pain": [
      "unbearable|excruciating|worst pain",
      "insupportable|atroce|douleur tres forte|douleur terrible",
      "ma\\s*y?t7[ae]mlch|wja3\\s*kbir\\s*barcha",
      "ما\\s*يتحملش"
    ],
    "anticoagulant": [
      "warfarin|coumadin|apixaban|eliquis|rivaroxaban|xarelto|heparin|blood thinners?",
      "sintrom|previscan|anticoagulant\\w*|kardegic|aspegic",
      "dwa\\s*mta3\\s*e?dam|ymaye3\\s*e?dam",
      "سنتروم|دواء\\s*يميع\\s*الدم"
