    "open_fracture": [
      "(?:see|seeing|visible)\\s+(?:the\\s+)?bone|bone\\s+(?:is\\s+)?(?:sticking|coming|poking)\\s+out|open\\s+fracture",
      "l.os\\s+(?:sort|est\\s+visible|depasse|dépasse)|fracture\\s+ouverte|on\\s+voit\\s+l.os",
      "(?:el\\s*)?3dh?am\\s*(?:ba?yen|5arej|kharej|dhaher|dhahra)|nchouf\\s*(?:fel\\s*|el\\s*)?3dh?am",
      "العظم\\s*(?:ظاهر|خارج|بارز|باين)|كسر\\s*مفتوح|نشوف\\s*في\\s*العظم"
